<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SerpyraToolkit</AssemblyName>
    <RootNamespace>SerpyraPC</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <StartupObject>SerpyraPC.Programa</StartupObject>
    <Version>1.0.0</Version>
    <Product>SerpyraToolkit para PC</Product>
    <Company>SerpyraToolkit</Company>
    <Copyright>SerpyraToolkit</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="fontes\*.ttf" />
    <EmbeddedResource Include="..\script\app.ps1" LogicalName="app.ps1" />
    <EmbeddedResource Include="gerado\toolkit.ps1" LogicalName="toolkit.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
