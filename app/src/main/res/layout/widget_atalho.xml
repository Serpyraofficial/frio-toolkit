<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/w_modojogo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_botao"
        android:gravity="center"
        android:text="Modo Jogo"
        android:textColor="#3DDC97"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_preparar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_botao"
        android:gravity="center"
        android:text="Preparar e jogar"
        android:textColor="#E8EEF5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_raiox"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_botao"
        android:gravity="center"
        android:text="Raio-X"
        android:textColor="#E8EEF5"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
